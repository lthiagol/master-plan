{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://master-plan.dev/schemas/brief.schema.json",
  "title": "ProjectBrief",
  "description": "Bootstrap brainstorm document. Planned mp brief commands (P0.5).",
  "type": "object",
  "required": ["brief", "topics"],
  "properties": {
    "brief": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["in_progress", "done"]
        },
        "created": { "type": "string" },
        "completed": { "type": "string" }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "key", "title", "prompt", "body", "status", "builtin", "order"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T[0-9]{2}$"
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "filled", "skipped", "na", "promoted"]
          },
          "builtin": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "order": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
