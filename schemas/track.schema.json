{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://master-plan.dev/schemas/track.schema.json",
  "title": "TrackItem",
  "description": "Item within a perpetual track (bugfix or tweak).",
  "type": "object",
  "required": ["title", "problem"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(BF|TW)-[0-9]{2}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["pending", "in-progress", "done", "cancelled", "archived"],
      "default": "pending"
    },
    "effort": { "type": "string", "enum": ["S", "M", "L"], "default": "S" },
    "problem": { "type": "string", "minLength": 1 },
    "done_when": { "type": "string" },
    "verification": { "type": "string" },
    "steps": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "evidence": { "type": "string" },
    "created": { "type": "string" },
    "completed": { "type": "string" },
    "archived_at": { "type": "string" }
  },
  "anyOf": [
    { "required": ["done_when"] },
    { "required": ["verification"] }
  ]
}
