{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://master-plan.dev/schemas/challenge.schema.json",
  "title": "ChallengeSession",
  "description": "Structured plan review session with findings. Planned mp challenge commands (P1.7).",
  "type": "object",
  "required": ["challenge", "findings"],
  "properties": {
    "challenge": {
      "type": "object",
      "required": ["id", "scope", "status"],
      "properties": {
        "id": { "type": "string" },
        "milestone_id": { "type": "string" },
        "scope": {
          "type": "string",
          "enum": ["spec", "plan", "full", "sequence"]
        },
        "status": {
          "type": "string",
          "enum": ["open", "closed"]
        },
        "created": { "type": "string" },
        "closed": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "title", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-[0-9]{2}$" },
          "severity": {
            "type": "string",
            "enum": ["minor", "major", "blocker"]
          },
          "category": {
            "type": "string",
            "enum": ["gap", "risk", "sequencing", "scope", "step-quality", "coverage"]
          },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "target": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["open", "resolved", "dismissed"]
          },
          "resolution": { "type": "string" },
          "action": { "type": "string" },
          "action_ref": { "type": "string" }
        }
      }
    }
  }
}
