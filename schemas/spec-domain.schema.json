{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://master-plan.dev/schemas/spec-domain.schema.json",
  "title": "DomainSpec",
  "description": "Long-lived domain truth under master-plan/specs/ (P4). Updated when delta milestones complete.",
  "type": "object",
  "required": ["domain"],
  "properties": {
    "domain": {
      "type": "object",
      "required": ["id", "title", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Filename stem: specs/{id}.toml"
        },
        "title": { "type": "string", "minLength": 1 },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Incremented on each delta merge"
        },
        "updated": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario" }
    },
    "interface": {
      "type": "object",
      "properties": {
        "endpoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/endpoint" }
        },
        "config_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/config_key" }
        },
        "cli_commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/cli_command" }
        }
      }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["id", "statement"],
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-[0-9]{2}$" },
        "statement": { "type": "string" },
        "scenarios": {
          "type": "array",
          "items": { "type": "string", "pattern": "^SC-[0-9]{2}$" }
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "title", "given", "when", "then"],
      "properties": {
        "id": { "type": "string", "pattern": "^SC-[0-9]{2}$" },
        "title": { "type": "string" },
        "priority": { "type": "string", "enum": ["P1", "P2", "P3"] },
        "given": { "type": "string" },
        "when": { "type": "string" },
        "then": { "type": "string" }
      }
    },
    "endpoint": {
      "type": "object",
      "required": ["method", "path"],
      "properties": {
        "method": { "type": "string" },
        "path": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "config_key": {
      "type": "object",
      "required": ["key", "type"],
      "properties": {
        "key": { "type": "string" },
        "type": { "type": "string" },
        "required": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "cli_command": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
